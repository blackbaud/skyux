{
  "name": "vitest",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/sdk/vitest/src",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": ["sdk", "npm"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/sdk/vitest",
        "tsConfig": "libs/sdk/vitest/tsconfig.lib.json",
        "packageJson": "libs/sdk/vitest/package.json",
        "main": "libs/sdk/vitest/src/index.ts",
        "assets": ["libs/sdk/vitest/*.md"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["{projectRoot}/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "outputs": ["{workspaceRoot}/coverage/{projectName}"],
      "options": {
        "runnerConfig": true,
        "setupFiles": ["libs/sdk/vitest/src/lib/matchers-setup.ts"],
        "coverage": true,
        "coverageInclude": ["libs/sdk/vitest/src/**/*.ts"],
        "coverageExclude": [
          "libs/sdk/vitest/src/**/*.spec.ts",
          "libs/sdk/vitest/src/testing/**",
          "libs/sdk/vitest/src/index.ts"
        ],
        "coverageThresholds": {
          "lines": 100,
          "functions": 100,
          "branches": 100,
          "statements": 100
        }
      }
    }
  }
}
