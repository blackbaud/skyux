{
  "name": "@skyux-sdk/vitest",
  "version": "0.0.0-PLACEHOLDER",
  "author": "Blackbaud, Inc.",
  "keywords": [
    "blackbaud",
    "skyux"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blackbaud/skyux.git"
  },
  "bugs": {
    "url": "https://github.com/blackbaud/skyux/issues"
  },
  "homepage": "https://github.com/blackbaud/skyux#readme",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./globals": {
      "types": "./globals.d.ts"
    },
    "./matchers-setup.js": {
      "types": "./src/lib/matchers-setup.d.ts",
      "default": "./src/lib/matchers-setup.js"
    }
  },
  "schematics": "@skyux-sdk/testing-schematics/collection.json",
  "ng-add": {
    "save": "devDependencies"
  },
  "ng-update": {
    "packageGroupName": "@skyux-sdk/vitest",
    "packageGroup": {
      "@skyux-sdk/vitest": "0.0.0-PLACEHOLDER",
      "@skyux-sdk/testing-schematics": "0.0.0-PLACEHOLDER",
      "axe-core": "~4.12.1"
    }
  },
  "peerDependencies": {
    "@angular/core": "^22.1.2",
    "@skyux/i18n": "0.0.0-PLACEHOLDER",
    "axe-core": "~4.12.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@skyux-sdk/testing-schematics": "0.0.0-PLACEHOLDER",
    "tslib": "^2.8.1"
  },
  "type": "commonjs",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "sideEffects": true
}
