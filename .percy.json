{
  "version": 2,
  "percy": {
    "defer-uploads": true
  },
  "snapshot": {
    "widths": [1280]
  },
  "discovery": {
    "allowed-hostnames": ["maxcdn.bootstrapcdn.com", "sky.blackbaudcdn.net"],
    "disable-cache": false,
    "concurrency": 15,
    "launch-options": {
      "timeout": 90000
    },
    "network-idle-timeout": 750
  }
}
